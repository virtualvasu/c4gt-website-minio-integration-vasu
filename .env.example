# ==========================================
# Flask Configuration
# ==========================================
# Generate a secure secret key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="change-this-to-a-secure-random-key"
FLASK_ENV="production"
FLASK_DEBUG=False

# ==========================================
# MySQL Database Configuration
# ==========================================
# Set these to match your MySQL setup
MYSQL_HOST="localhost"
MYSQL_DATABASE="c4gt_db"
MYSQL_USER="root"
MYSQL_PASSWORD="change-this-password"
# Format: mysql+pymysql://user:password@host:port/database
SQLALCHEMY_DATABASE_URI="mysql+pymysql://root:change-this-password@localhost:3306/c4gt_db"
SQLALCHEMY_TRACK_MODIFICATIONS="False"

# ==========================================
# Application Configuration
# ==========================================
APP_TITLE="SocialCalc - Spreadsheet Tool"

# ==========================================
# MinIO Storage Configuration
# ==========================================
# Set these to match your MinIO instance
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ACCESS_KEY="change-this-access-key"
MINIO_SECRET_KEY="change-this-secret-key"
MINIO_BUCKET_NAME="c4gt-storage"
# For Docker setup only - not needed for standalone MinIO
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="change-this-password"

